class Vehiculo:
    
    def __init__(self,chofer, kilometros=0):
        self.kilometros = kilometros
        self.chofer = chofer

    def cambiar_chofer(self, chofer):
        self.chofer = chofer

class Moto(Vehiculo):
    def __init__(self, chofer, kilometros=0):
        super().__init__(chofer, kilometros)
        self.acompanante = False
    
    def agregar_acomanante(self, acompanante):
        self.acompanante = True

    def cambiar_chofer(self, chofer):
        if not self.acompanante:
            super().cambiar_chofer(chofer)
        else:
            print("No se puede cambiar el chofer si hay pasajeros")

class Colectivo(Vehiculo):
    def __init__(self, chofer, kilometros=0):
        super().__init__(chofer, kilometros)
        self.pasajeros = []

    def agregar_pasajero(self, pasajero):
        self.pasajeros.append(pasajero)

    def cambiar_chofer(self, chofer):
        if len(self.pasajeros) == 0:
            super().cambiar_chofer(chofer)
        else:
            print("No se puede cambiar el chofer si hay pasajeros")

    








from abc import ABC, abstractmethod
class Empleado(ABC):
    def __init__(self, horas, antiguedad, hijos, casado):
        self.horas = horas
        self.antiguedad = antiguedad
        self.hijos = hijos
        self.casado = casado

    def salario_familiar(self):
        salario = self.hijos * 200
        if self.casado:
            salario += 100
        return salario

    @abstractmethod
    def sueldo(self):
        pass

         
class PlantaPermanente(Empleado):
    def sueldo(self):
        sueldo = self.horas * 300
        sueldo +=self.antiguedad * 100
        sueldo += self.salario_familiar()
        return sueldo
    

class PlantaTemporaria(Empleado):

    def sueldo(self):
        sueldo = self.horas * 200
        sueldo += self.salario_familiar()
        return sueldo

class Gerente(PlantaPermanente):
    
     def sueldo(self):
        sueldo = self.horas * 400
        sueldo +=self.antiguedad * 150
        sueldo += self.salario_familiar()
        return sueldo





class Empresa:
    def __init__(self, razon_social):
        self.razon_social = razon_social
        self.empleados = []

    def agregar_empleados(self, empleado):
        self.empleados.append(empleado)

    def monto_total(self):
        monto_total = 0
        for emp in self.empleados:
            monto_total += emp.sueldo() 
        return monto_total


            













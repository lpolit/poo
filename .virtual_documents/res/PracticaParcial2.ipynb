"""
Partiendo de un archivo txt con el siguiente contenido:

nombre=Auto
atributos=ruedas,color,puertas
metodos=arrancar,detener

Crear una clase "Generador" que almacene la informacion leida de un archivo con los datos declarativos de una clase python.
Que tenga un metodo "generar" capaz de crear un archivo .py conteniendo la declaracion y el cuerpo de una clase:
constructor, getter por cada atributo y metodos necesarios.


"""

class Generador:

    def __init__(self):
        self.nombre = None
        self.atributos = []
        self.metodos = []

    def leer_archivo(self, ruta_archivo):
        """Lee el archivo y asigna los valores a los atributos de la clase."""
        try:
            with open(ruta_archivo, 'r', encoding='utf-8') as f:
                for linea in f:
                    linea = linea.replace(" ", "").strip()
                    if not linea or '=' not in linea:
                        continue
                    clave, valor = linea.split('=')

                    if clave == 'nombre':
                        self.nombre = valor
                    elif clave == 'atributos':
                        self.atributos = valor.split(',')
                    elif clave == 'metodos':
                        self.metodos = valor.split(',')
        except FileNotFoundError:
            print("El archivo no fue encontrado.")


    def generar(self, salida=None):
        """Genera un archivo .py con la clase correspondiente."""
        if not self.nombre:
            # self.nombre = "dummy"
            raise ValueError("No se ha especificado un nombre de clase en el archivo.")


        salida = salida or f"{self.nombre.lower()}.py"

        with open(salida, 'w', encoding='utf-8') as f:
            f.write(f"class {self.nombre}:\n")
            if self.atributos:
                args = ', '.join(self.atributos)
                f.write(f"\tdef __init__(self, {args}):\n")
                for a in self.atributos:
                    f.write(f"\t\tself.{a} = {a}\n")
                f.write("\n")
            else:
                f.write("\tdef __init__(self):\n\t\tpass\n\n")

            for g in self.atributos:
                f.write(f"\tdef get_{g}(self):\n\t\treturn self.{g}\n\n")

            for m in self.metodos:
                f.write(f"\tdef {m}(self):\n\t\tpass\n\n")

        print(f"Archivo '{salida}' generado con éxito.")


g = Generador()
g.leer_archivo("entrada.txt")
g.generar()







# Decorador
def registrar_llamada(func):
    def wrapper(*args, **kwargs):
        print(f"Llamando a {func.__name__} con argumentos: {args}, {kwargs}")
        resultado = func(*args, **kwargs)
        return resultado
    return wrapper

# Función principal decorada
@registrar_llamada
def buscar_producto(productos, nombre):
    """
    Busca un producto por su nombre dentro de una lista de diccionarios.
    Devuelve el precio o None si no existe.
    """
    for producto in productos:
        if producto["nombre"].lower() == nombre.lower():
            print(f"Precio encontrado: {producto['precio']}")
            return producto["precio"]
    print("Producto no encontrado.")
    return None

if __name__ == "__main__":
    productos = [
        {"nombre": "Mouse", "precio": 2000},
        {"nombre": "Teclado", "precio": 3500},
        {"nombre": "Monitor", "precio": 9000}
    ]

    buscar_producto(productos, "Mouse")
    buscar_producto(productos, "Notebook")



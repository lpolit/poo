








class Estudiante:

    def __init__(self, nombre, nota):
        self.nombre = nombre
        self.nota = nota
    
    def imprimir(self):
        print(f'Nombre: {self.nombre}')
        print(f'Nota: {self.nota}')
    
    def resultado(self):
        print('aprobado' if self.nota >= 4 else 'desaprobado')


estudiante_1 = Estudiante('Pablo', 8)
estudiante_2 = Estudiante('Ana', 2)

estudiante_1.imprimir()
estudiante_1.resultado()

estudiante_2.imprimir()
estudiante_2.resultado()








class Persona:

    def __init__(self, nombre, edad):
        self.nombre = nombre
        self.edad = edad
    
    def cumpleaños(self):
        self.edad += 1
    
    def __str__(self):
        return f'{self.nombre} -> {self.edad}'


persona_1 = Persona('Pablo', 49)
print(persona_1)
persona_1.cumpleaños()
print(persona_1)








class Calculadora:

    def __init__(self):
        self.n1 = int(input('Número 1: '))
        self.n2 = int(input('Número 2: '))
    
    def sumar(self):
        return self.n1 + self.n2
    
    def restar(self):
        return self.n1 - self.n2
    
    def multiplicar(self):
        return self.n1 * self.n2
    
    def dividir(self):
        if self.n2 != 0:
            return self.n1 / self.n2
        return 0


calc = Calculadora()
print(calc.sumar())
print(calc.restar()) 
print(calc.multiplicar())
print(calc.dividir())








class Nota:

    def __init__(self, valor_inicial):
        self.__validar_valor(valor_inicial)
        self.__valor = valor_inicial
   
    
    def __validar_valor(self, valor):
        if not isinstance(valor, int) or not 0 <= valor <=10:
            raise ValueError("El valor tiene que ser mayor a 0 y menor a 10")

    def obtener_valor(self):
        return self.__valor

    def aprobado(self):
        return self.__valor >= 4

    def desaprobado(self):
        return self.__valor < 4

    def recuperar(self, nuevo_valor):        
        self.__validar_valor(nuevo_valor)
        if self.__valor < nuevo_valor:
            self.__valor = nuevo_valor
    
    
    
            

        


import unittest

class TestNota(unittest.TestCase):
    
    def test_crear_nota_valida(self):
        nota = Nota(8)
        self.assertEqual(nota.obtener_valor(),8)

    def test_aprobado(self):
        nota = Nota(4)
        self.assertTrue(nota.aprobado())

    def test_crear_nota_invalida(self):
        with self.assertRaises(ValueError):
            nota = Nota(12)

    def test_crear_nota_invalida_caracter(self):
        with self.assertRaises(ValueError):
            nota = Nota("a")


    


unittest.main(defaultTest='TestNota', argv=[''], verbosity=2, exit=False)









import math

class Punto:

    def __init__(self, x, y):
        self.__x = x
        self.__y = y

    def esta_sobre_el_eje_x(self):
        return self.__y == 0
        
    def esta_sobre_el_eje_y(self):
        return self.__x == 0

    def es_el_eje_de_coordenadas(self):
        return self.__x == 0 and self.__y == 0

    def distancia_al_origen(self):
        return math.sqrt(self.__x ** 2 + self.__y ** 2)


    def distancia(self, p1):
        return Punto.distancia_entre(self, p1)

    @staticmethod
    def distancia_entre(p1, p2):
        return math.sqrt((p1.__x - p2.__x)**2 + (p1.__y - p2.__y)**2)    
    


    
        


import unittest

class TestPunto(unittest.TestCase):

    def test_punto_sobre_eje_x(self):
        p = Punto(5,0)
        self.assertTrue(p.esta_sobre_el_eje_x())

    def test_distancia_entre_puntos(self):
        p1 = Punto(0,0)
        p2 = Punto(3,4)

        self.assertEqual(Punto.distancia_entre(p1,p2), 5)

    def test_distancia_al_origen(self):
        p = Punto(3,4)

        self.assertEqual(p.distancia_al_origen(), 5)
        
                                    




unittest.main(defaultTest='TestPunto', argv=[''], verbosity=2, exit=False)



















































































































































































class Maquina:
    def __init__(self, cantidad):
        #[False,False,False,False,False]
        self.__pulsadores = [False] * cantidad

    def activar_pulsador(self, numero):
        self.__pulsadores[numero] = True

    def desactivar_pulsador(self, numero):
        self.__pulsadores[numero] = False

    def activado(self, numero):
        return self.__pulsadores[numero]

    def num_activos(self):
        cantidad=0
        
        for i in range(len(self.__pulsadores)):
            if self.__pulsadores[i]:
            #if i == True:
                cantidad+=1
        return cantidad

    def mostrar(self):
        return self.__pulsadores
                
 
m=Maquina(5)
m.activar_pulsador(1)
m.activar_pulsador(3)
m.activar_pulsador(2)
m.desactivar_pulsador(3)
print(m.mostrar())
print(m.num_activos())


import unittest

class TestMaquina(unittest.TestCase):

    def test_todos_activos(self):
        maq=Maquina(5)   
        maq.activar_pulsador(0)
        maq.activar_pulsador(1)
        maq.activar_pulsador(2)
        maq.activar_pulsador(3)
        maq.activar_pulsador(4)
        self.assertEqual([True,True,True,True,True], maq.mostrar())
        #self.assertTrue(maq.activado(0) and maq.activado(1) and maq.activado(2) and maq.activado(3) and maq.activado(4))


    def test_num_activos_despues_de_activar(self):
        maq=Maquina(5)
        maq.activar_pulsador(0)
        maq.activar_pulsador(1)

        self.assertEqual(maq.num_activos(),2)

    def test_desactivar_pulsador(self):
        maq=Maquina(5)
        maq.activar_pulsador(0)
        maq.desactivar_pulsador(0)
        self.assertFalse(maq.activado(0))




unittest.main(defaultTest='TestMaquina', argv=[''], verbosity=2, exit=False)

















class Universidad:

    def __init__(self, nombre):
        self.nombre = nombre


class Carrera:

    def __init__(self, especialidad):
        self.especialidad = especialidad


class Estudiante:

    def __init__(self, nombre, edad):
        self.nombre = nombre
        self.edad = edad


def persona(universidad, carrera, estudiante):
    return f'Universidad: {universidad.nombre}, Carrera: {carrera.especialidad}, Estudiante: {estudiante.nombre}, Edad: {estudiante.edad}'


universidad = Universidad('UNO')
carrera = Carrera('Esp en Cs de Datos')
estudiante = Estudiante('Pablo Pandolfo', 49)
print(persona(universidad, carrera, estudiante))










from abc import ABC, abstractmethod
import math

# 1. Definimos la "interfaz" Figura
class Figura(ABC):
    
    @abstractmethod
    def area(self):
        pass


# 2. Implementamos las clases concretas
class Cuadrado(Figura):
    
    def __init__(self, lado):
        self.__lado = lado

    def area(self):
        return self.__lado * self.__lado


class Circulo(Figura):
    
    def __init__(self, radio):
        self.__radio = radio

    def area(self):
        return math.pi * (self.__radio ** 2)


class Rectangulo(Figura):
    
    def __init__(self, base, altura):
        self.__base = base
        self.__altura = altura

    def area(self):
        return self.__base * self.__altura


# 3. Clase de prueba (simulación del "main")
class TestInterface:
    
    @staticmethod
    def main():
        # Creamos un arreglo de figuras
        figuras = [
            Cuadrado(4),
            Circulo(3),
            Rectangulo(5, 2),
            Cuadrado(6),
            Circulo(1)
        ]

        # Calculamos el área total usando polimorfismo
        area_total = sum(f.area() for f in figuras)

        # Mostramos el resultado
        print(f"De un total de {len(figuras)} figuras, el área total es de {area_total}")


# 4. Ejecutamos el main
if __name__ == "__main__":
    TestInterface.main()








from abc import ABC, abstractmethod

class Sociedad(ABC):
    def  __init__(self, denominacion, domicilio, capital, cuit):
        self.denominacion = denominacion
        self.domicilio = domicilio
        self.capital = capital
        self.cuit = cuit

   
    def mostrar_info(self):
        print(f"la denominacion es: {self.denominacion}")
        print(f"El domicilio es: {self.domicilio}")
        print(f"El capital es: {self.capital}")
        print(f"la cuit es: {self.cuit}")

    
    def comparar_capital(self, otra_soc):
        if self.capital > otra_soc.capital:
            print(f"el capital de {self.denominacion} es mayor que el de {otra_soc.denominacion}")
        elif self.capital < otra_soc.capital:
            print(f"el capital de {self.denominacion} es menor que el de {otra_soc.denominacion}")
        else:
            print(f"el capital de {self.denominacion} y {otra_soc.denominacion} son iguales")

class SA(Sociedad):
    
    # cantidad de acciones, precio de cada acción, cotiza en bolsa (s/n), cantidad de directores
    def __init__(self, denominacion, domicilio, capital, cuit, cant_acciones, precio_accion, cotiza_bolsa, cant_directores):
        super().__init__(denominacion, domicilio, capital, cuit)
        self.cant_acciones = cant_acciones
        self.precio_accion = precio_accion
        self.cotiza_bolsa = cotiza_bolsa
        self.cant_directores = cant_directores

    def mostrar_info(self):
        print("SOY UNA SOCIEDAD ANONIMA")
        super().mostrar_info()
        print(f"la cantidad de acciones son: {self.cant_acciones}")
        print(f"precio de accion es: {self.precio_accion}")
        print(f"Cotiza en bolsa: {self.cotiza_bolsa}")
        print(f"la cantidad de directores es: {self.cant_directores}")



#[{"nombre":"pedro", "patrimonio:1000}, {"nombre":"Juan", "patrimonio:500}]
#{"nombre":"pedro", "patrimonio:1000}  

class SRL(Sociedad):
    #nombre de socios gerentes (máximo 3), patrimonio personal de cada socio gerente, cantidad de socios no gerentes
    def __init__(self, denominacion, domicilio, capital, cuit, socios_gerentes,cant_socios_no_gerentes):
        super().__init__(denominacion, domicilio, capital, cuit)
        
        if len(socios_gerentes) > 3:
            raise ValueError("No puede haber mas de 3 socios gerentes")
        
        self.socios_gerentes = socios_gerentes
        self.cant_socios_no_gerentes = cant_socios_no_gerentes

    def mostrar_info(self):
        print("SOY UNA SOCIEDAD DE RESPONSABILIDAD LIMITADA")
        super().mostrar_info()
        print(f"Los socios gerentes son:")

        for soc in self.socios_gerentes:
            print(f"{soc['nombre']} con patrimonio ${soc['patrimonio']}")

        print(f"la cantidad de socios no gerentes es: {self.cant_socios_no_gerentes}")
        

class SH(Sociedad):
    #lista de los nombres de los socios, porcentaje de participación de cada socio
    #socios = [{"nombre":"pedro", "porcentaje":10}]
    def __init__(self, denominacion, domicilio, capital, cuit, socios):
        super().__init__(denominacion, domicilio, capital, cuit)
        self.socios = socios


    def mostrar_info(self):
        print("SOY UNA SOCIEDAD DE HECHO")
        super().mostrar_info()
        print("Los Socios son:")

        for soc in self.socios:
            print(f"{soc['nombre']} con porcentaje %{soc['porcentaje']}")

    


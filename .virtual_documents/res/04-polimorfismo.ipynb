








from abc import ABC, abstractmethod
import math

# 1. Definimos la "interfaz" Figura
class Figura(ABC):
    
    @abstractmethod
    def area(self):
        pass


# 2. Implementamos las clases concretas
class Cuadrado(Figura):
    
    def __init__(self, lado):
        self.__lado = lado

    def area(self):
        return self.__lado * self.__lado


class Circulo(Figura):
    
    def __init__(self, radio):
        self.__radio = radio

    def area(self):
        return math.pi * (self.__radio ** 2)


class Rectangulo(Figura):
    
    def __init__(self, base, altura):
        self.__base = base
        self.__altura = altura

    def area(self):
        return self.__base * self.__altura


# 3. Clase de prueba (simulación del "main")
class TestInterface:
    
    @staticmethod
    def main():
        # Creamos un arreglo de figuras
        figuras = [
            Cuadrado(4),
            Circulo(3),
            Rectangulo(5, 2),
            Cuadrado(6),
            Circulo(1)
        ]

        # Calculamos el área total usando polimorfismo
        area_total = sum(f.area() for f in figuras)

        # Mostramos el resultado
        print(f"De un total de {len(figuras)} figuras, el área total es de {area_total}")


# 4. Ejecutamos el main
if __name__ == "__main__":
    TestInterface.main()







































































from abc import ABC, abstractmethod

# Clase base
class Material(ABC):

    def __init__(self, codigo, titulo, categoria):
        self.__codigo = codigo
        self.__titulo = titulo
        self.__categoria = categoria

    def get_codigo(self):
        return self.__codigo

    def get_titulo(self):
        return self.__titulo

    def get_categoria(self):
        return self.__categoria


    def info(self):
        return f"{self.get_titulo()} - Código: {self.get_codigo()} -  Categoría: {self.get_categoria()}"


# Subclase 1
class LibroDigital(Material):

    def __init__(self, codigo, titulo, categoria, capitulos):
        super().__init__(codigo, titulo, categoria)
        self.__capitulos = capitulos

    def get_capitulos(self):
        return self.__capitulos

    def info(self):
        return f"{super().info()} - Capítulos: {self.__capitulos}"


# Subclase 2
class Podcast(Material):

    def __init__(self, codigo, titulo, categoria, presentador):
        super().__init__(codigo, titulo, categoria)
        self.__presentador = presentador

    def get_presentador(self):
        return self.__presentador

    def info(self):
        return f"{super().info()} - Presentador: {self.get_presentador()}"


# Subclase 3
class RevistaInteractiva(Material):

    def __init__(self, codigo, titulo, categoria, ediciones_anuales):
        super().__init__(codigo, titulo, categoria)
        self.__ediciones_anuales = ediciones_anuales

    def get_ediciones_anuales(self):
        return self.__ediciones_anuales

    def info(self):
        return f"{super().info()} -  Ediciones/año: {self.get_ediciones_anuales()}"


# Función solicitada
def filtrar_por_categoria(materiales, categoria_buscada):
    resultado = []

    for material in materiales:

        if material.get_categoria().lower() == categoria_buscada.lower():
            resultado.append(material)

    return resultado


## ------------------------- TEST - --------------------------
import unittest

class TestFiltrarPorCategoria(unittest.TestCase):

    def test_filtrado_programacion(self):
        materiales = [
            LibroDigital("L001", "Python desde cero", "Programación", 12),
            Podcast("P001", "Charlas Tech", "Tecnología", "Laura Gómez"),
            RevistaInteractiva("R001", "Ciencia Hoy", "Divulgación", 6),
            LibroDigital("L002", "POO Avanzado", "Programación", 15)
        ]

        resultado = filtrar_por_categoria(materiales, "Programación")

        self.assertEqual(len(resultado), 2)


unittest.main(argv=[''], verbosity=2)

from abc import ABC, abstractmethod

class Entregable(ABC):

    @abstractmethod
    def entregar(self):
        pass

    @abstractmethod
    def devolver(self):
        pass

    @abstractmethod
    def is_entregado(self):
        pass

    @abstractmethod
    def comparar(self, otro):
        pass
    
    

class Pelicula(Entregable):
    def __init__(self, titulo="", anio="", entregado=False, genero="no definido", director=""):
        self.__titulo = titulo
        self.__anio = anio
        self.__entregado = entregado
        self.__genero = genero
        self.__director = director

    ## Getters 
    def get_titulo(self):
        return self.__titulo

    ## Setters
    def set_titulo(self, un_titulo):
        self.__titulo = un_titulo

    ### Sobreescribiendo el metodo __str__
    def __str__(self):
        return f"La Pelicula tiene como titulo: {self.__titulo} del año: {self.__anio}......."

    ## IMPLEMENTADO METODOS DE LA INTERFAZ (Clase Abstracta)
        
    def entregar(self):
        self.__entregado = True

    def devolver(self):
        self.__entregado = False

    def is_entregado(self):
        return self.__entregado

    def comparar(self, otro):
        return self.__anio == self.__anio
    



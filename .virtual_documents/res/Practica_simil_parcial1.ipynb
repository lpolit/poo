





from abc import ABC, abstractmethod
from enum import Enum

class Publicacion(ABC):
    def __init__(self, titulo, autor, visualizaciones):
        self.__titulo = titulo
        self.__autor = autor
        self.__visualizaciones = visualizaciones

    @property
    def titulo(self):
        return self.__titulo

    @property
    def autor(self):
        return self.__autor

    @property
    def visualizaciones(self):
        return self.__visualizaciones

    def mostrar_info(self):
        print(f"Titulo:{self.__titulo}. El Autor es: {self.__autor}. La cantidad de visualizaciones es: {self.__visualizaciones}")

    @abstractmethod
    def calcular_puntos(self):
        pass
    
    

class CalidadVideo(Enum):
    HD = "HD"
    FULL_HD = "FULL_HD"
    _4K = "4K"


class PublicacionTexto(Publicacion):
    
    def calcular_puntos(self):
        return self.visualizaciones * 2


class PublicacionVideo(Publicacion):
    
    def __init__(self, titulo, autor, visualizaciones, calidad):
        super().__init__(titulo, autor, visualizaciones)
        self.__calidad = calidad

    @property
    def calidad(self):
        return self.__calidad

    def calcular_puntos(self):
        return self.visualizaciones * 5

    def mostrar_info(self):
        super().mostrar_info()
        print(f"La calidad del video es: {self.__calidad.value}")

def mostrar_puntos(publicacion):
    print(f"La cantidad de puntos obtenidos es {publicacion.calcular_puntos()}")
        
## EJECUCION

p1 = PublicacionTexto("Aprendiendo Python", "Pedro", 20)
p2 = PublicacionVideo("Curso Java", "Maria", 200, CalidadVideo.FULL_HD)

p1.mostrar_info()
p2.mostrar_info()

mostrar_puntos(p1)
mostrar_puntos(p2)

    

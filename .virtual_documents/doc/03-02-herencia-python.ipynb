    # constructores se heredan
    def __init__(self):
        # se puede invocar del constructor de la subclase a la superclase con super().__init__()
        super().__init__()








def __str__(self):
    pass


def __eq__(self, otro_objeto):
    pass


# Se invoca a los métodos para ver que traen

## Implementado Enum
from enum import Enum
class Semaforo(Enum):
    ROJO = "Rojo"
    AMARILLO = "Amarillo"
    VERDE = "Verde"

color_actual= Semaforo.VERDE

if color_actual == Semaforo.ROJO:
    print("Detenerse!")
elif color_actual ==  Semaforo.VERDE:
    print("Avazar!")
elif color_actual ==  Semaforo.AMARILLO:
    print("Precausion!")










